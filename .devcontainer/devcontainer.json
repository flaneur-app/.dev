{
  "name": "Flâneur",
  // Stable machine name: Remote Control names the environment "<hostname>:<folder>", and the
  // default hostname is the container id, which changes on every rebuild.
  "runArgs": ["--hostname=flaneur-app"],
  "image": "mcr.microsoft.com/devcontainers/typescript-node:26",
  "workspaceFolder": "/workspaces/.dev",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/.dev,type=bind,consistency=cached",
  "features": {
    // Secrets come from OpenBao (kv/shared/*, then kv/orgs/flaneur-app) into every process's env,
    // VS Code included. Not in remoteEnv: `${localEnv:…}` is empty when VS Code attaches and
    // would override them.
    "ghcr.io/helpers4/devcontainer/openbao-env:1": {
      "address": "https://bao.baxyz.dev",
      "paths": "shared/font-awesome,shared/web-awesome,orgs/flaneur-app"
    },
    "ghcr.io/helpers4/devcontainer/org-workspace:1": {
      "autoDiscover": "public,private,internal,fork"
    },
    "ghcr.io/devcontainers/features/git-lfs:1": {},
    "ghcr.io/helpers4/devcontainer/shell-history:1": {},
    "ghcr.io/helpers4/devcontainer/git-absorb:1": {},
    "ghcr.io/helpers4/devcontainer/essential-dev:1": {},
    "ghcr.io/helpers4/devcontainer/github-dev:1": {},
    "ghcr.io/helpers4/devcontainer/auto-header:1": {
      "projectName": "Flâneur",
      "license": "AGPL-3.0-or-later"
    },
    "ghcr.io/helpers4/devcontainer/typescript-dev:1": {},
    "ghcr.io/helpers4/devcontainer/vite-plus:1": {},
    "ghcr.io/helpers4/devcontainer/pnpm-store:1": {},
    "ghcr.io/helpers4/devcontainer/package-auto-install:1": {
      "autoDiscover": true
    },
    // ── Rust + GNOME (core, connectors, app-gnome) ─────────────────────────────
    // rustup is installed by the feature; the toolchain each repo pins in rust-toolchain.toml
    // is fetched on first use.
    "ghcr.io/devcontainers/features/rust:1": {
      "profile": "default"
    },
    // Development headers of the GNOME stack the app links against, the GStreamer plugins that
    // play video, and the tools of the GNOME build (Blueprint, gettext, AppStream checks).
    // Flatpak bundles are built in CI, not here: flatpak-builder needs user namespaces, which the
    // default Docker seccomp and AppArmor profiles deny.
    "ghcr.io/devcontainers-extra/features/apt-get-packages:1": {
      "packages": "pkg-config,libssl-dev,libsqlite3-dev,libgtk-4-dev,libgtk-4-bin,libadwaita-1-dev,libgstreamer1.0-dev,libgstreamer-plugins-base1.0-dev,gstreamer1.0-plugins-good,gstreamer1.0-plugins-bad,gstreamer1.0-libav,gstreamer1.0-gtk4,blueprint-compiler,gettext,desktop-file-utils,appstream,waypipe"
    },
    "ghcr.io/helpers4/devcontainer/claude-dev:1": {
      "remoteControl": true,
      "remoteControlAutoTrust": true,
      // Sessions started from claude.ai run unwatched: a permission prompt would stall them.
      "remoteControlPermissionMode": "auto",
      // Default model of those sessions (claude-dev ≥ 1.4.2).
      "remoteControlModel": "sonnet"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode-remote.remote-containers"
      ]
    }
  },
  "forwardPorts": [5173, 8080],
  "portsAttributes": {
    "5173": {
      "label": "Vite dev server",
      "onAutoForward": "notify"
    },
    // GTK's Broadway backend: run the app with GDK_BACKEND=broadway after `broadwayd :0`, and
    // look at its layout in a browser. No video: use waypipe or the Flatpak for playback.
    "8080": {
      "label": "GTK Broadway",
      "onAutoForward": "silent"
    }
  },
  "remoteUser": "node"
}
